type _ImmutableObjectStorageRefillResult = 
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult = 
 record {
   blob_hash: text;
   method: text;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type ReservationId = nat;
type Reservation = 
 record {
   createdAt: int;
   date: text;
   id: ReservationId;
   message: text;
   name: text;
   partySize: nat;
   time: text;
 };
type GalleryImageId = nat;
type GalleryImage = 
 record {
   "blob": ExternalBlob;
   createdAt: int;
   id: GalleryImageId;
   name: text;
 };
type ExternalBlob = blob;
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type DishId = nat;
type DishCategory = 
 variant {
   boissons;
   desserts;
   plats;
 };
type Dish = 
 record {
   category: DishCategory;
   description: text;
   id: DishId;
   imageRef: text;
   name: text;
   popular: bool;
   priceDt: nat;
   tags: vec text;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  createReservation: (name: text, date: text, time: text, partySize: 
   nat, message: text) -> (Reservation);
  execute: (qJson: text) -> (Result) query;
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  getDish: (id: DishId) -> (opt Dish) query;
  getDishes: () -> (vec Dish) query;
  getGalleryImages: () -> (vec GalleryImage) query;
  getReservations: () -> (vec Reservation) query;
  isCallerAdmin: () -> (bool) query;
  schema: () -> (text) query;
  uploadGalleryImage: (name: text, "blob": ExternalBlob) -> (GalleryImage);
}
